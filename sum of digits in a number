import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int i = 0;
        int j = n;
        while(n > 0) {
            i+= n%10;
            n = n/10;
        }
        System.out.println("sum of digit" + j + " are : " + i );
    }
}
